{
  "name": "dota-pack-manager",
  "version": "0.4.0",
  "description": "Dota 2 Mod/Pack Manager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "catalog": "node tools/make-catalog.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.14",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "archiver": "^7.0.1"
  },
  "build": {
    "appId": "local.dota.packmanager",
    "productName": "Dota 2 Pack Manager",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Dota 2 Pack Manager",
      "artifactName": "Dota2PackManager-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "language": "1049"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/dota-pack-manager/updates/"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "assets/**/*",
      "package.json"
    ]
  }
}